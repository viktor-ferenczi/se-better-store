<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the trade planning, which needs no game code. Run with "dotnet run" in this folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ClientPlugin/Trading/*.cs" Link="Trading/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
